DATABASE_URL=file:./local.db
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
TMDB_KEY=
TMDB_CRON=0 4 * * *
TMDB_SYNC_MAX_PAGES=5
# The worker runs in America/Argentina/Buenos_Aires.
# Comma-separated web origins; native apps do not require browser CORS.
CORS_ORIGINS=http://localhost:8081

# Optional custom Overpass endpoint. Defaults to public OSM servers with failover.
# Use a dedicated provider for production traffic if needed.
OVERPASS_URL=

# Optional Expo enhanced push security access token (server only).
EXPO_ACCESS_TOKEN=
# Defaults: uploads and a backups folder beside the SQLite database.
# UPLOAD_DIR=
# BACKUP_DIR=

# Wallet vouchers: server-side credentials only. Leave blank until issuer accounts exist.
WALLET_PUBLIC_BASE_URL=
WALLET_APPLE_PASS_TYPE_ID=
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_CERT_PATH=
WALLET_APPLE_KEY_PATH=
WALLET_APPLE_WWDR_PATH=
WALLET_APPLE_KEY_PASSPHRASE=
# Optional custom PNG icon; a WhatNext icon is bundled by default.
WALLET_APPLE_ICON_PATH=
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_CLASS_ID=
WALLET_GOOGLE_CREDENTIALS_PATH=
# Comma-separated HTTPS web origins hosting the Google Wallet action.
WALLET_GOOGLE_ORIGINS=
# Optional public HTTPS logo URL for Google Wallet.
WALLET_LOGO_URL=

# Optional override of the official Argentine cinema directory CSV.
CINEMA_DIRECTORY_URL=
