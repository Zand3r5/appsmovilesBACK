NODE_ENV=production
DATABASE_URL=file:/data/whatnext.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
CORS_ORIGINS=https://your-web-app.example
TMDB_KEY=
TMDB_CRON=0 4 * * *
TMDB_SYNC_MAX_PAGES=5
# Optional enhanced security for Expo Push Service. Keep this server-side.
EXPO_ACCESS_TOKEN=
# Optional dedicated OpenStreetMap Overpass endpoint.
OVERPASS_URL=

# Wallet: mount credential files read-only in /run/secrets/whatnext.
# Public base is the origin (no /api suffix), e.g. https://api.example.com.
WALLET_PUBLIC_BASE_URL=
WALLET_APPLE_PASS_TYPE_ID=
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_CERT_PATH=
WALLET_APPLE_KEY_PATH=
WALLET_APPLE_WWDR_PATH=
WALLET_APPLE_KEY_PASSPHRASE=
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_CLASS_ID=
WALLET_GOOGLE_CREDENTIALS_PATH=
WALLET_GOOGLE_ORIGINS=
WALLET_LOGO_URL=
